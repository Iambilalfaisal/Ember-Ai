# Copy to .env and adjust. No real values here. Nested settings use "__" (EMBER_DB__URL).
# Settings sections are added by F1 (core/config.py); keep this file in sync with it.

# local | test | staging | production (required; there is no default)
EMBER_ENV=local

# Database (docker-compose defaults; host port 5433 avoids clashing with a local Postgres on 5432)
EMBER_DB__URL=postgresql+asyncpg://ember:ember@localhost:5433/ember

# Redis (docker-compose defaults)
EMBER_REDIS__URL=redis://localhost:6379/0

# Background jobs (defaults shown; the Redis above carries the queue)
# EMBER_TASKS__QUEUE_NAME=ember
# EMBER_TASKS__RESULT_TTL_SECONDS=3600

# Entra ID sign-in. Required when EMBER_ENV is staging or production; unused in local.
EMBER_AUTH__ENTRA_TENANT_ID=
EMBER_AUTH__AUDIENCE=
# Optional tuning (defaults shown):
# EMBER_AUTH__AUTHORITY=https://login.microsoftonline.com
# EMBER_AUTH__JWKS_CACHE_SECONDS=3600
# EMBER_AUTH__JWKS_MIN_REFRESH_SECONDS=60
# EMBER_AUTH__JWKS_TIMEOUT_SECONDS=5
# EMBER_AUTH__CLOCK_SKEW_SECONDS=30

# Local dev tokens (at least 32 characters). Honoured only when EMBER_ENV=local and the app
# refuses to start if it is set anywhere else. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# then mint a token with: uv run python scripts/dev_token.py --role admin
# EMBER_AUTH__DEV_SIGNING_KEY=<paste the generated key here>

# Langfuse Cloud, local development only, fake or anonymised data only (ADR 0002).
# Create a free project at https://cloud.langfuse.com and paste its keys into your own .env.
EMBER_OBSERVABILITY__LANGFUSE_HOST=https://cloud.langfuse.com
EMBER_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
EMBER_OBSERVABILITY__LANGFUSE_SECRET_KEY=
